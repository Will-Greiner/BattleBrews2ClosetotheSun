  m_Name: Murphy Enters the Arena
  m_EditorClassIdentifier: Assembly-CSharp::EncounterData
  encounterName: Murphy Enters the Arena
  opponentName: Murphy, Lord of Bad Timing
  selectRandomPotion: 0
  bestPotion: {fileID: 11400000, guid: 097df593ae55a6740a3f788f52cb6ae0, type: 2}
  firstRound: 1
  lastRound: 8
  requestDialogue: '{opponent} never attacks directly. He waits until your sandal
    snaps, your eye itches, and the sun gets in your face. Brew me a {potion}. I
    want bad timing on my side.'
  winOutcomeText: Murphy raised his sword just as his belt failed, the arena gate
    jammed, and a pigeon chose violence. The gladiator barely had to swing.
  loseOutcomeText: The gladiator charged heroically, sneezed inside the helmet, and
    ran into the starting gate. Murphy called it a professional courtesy.
